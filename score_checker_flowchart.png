<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="nusdfijjfefue"/>
        <attribute name="authors" value="Kyler"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-06 01:09:01 PM"/>
        <attribute name="created" value="S3lsZXI7S1lMRVI7MjAyNi0wOS0wNTswMToxNzo1NSBQTTsyMTk3"/>
        <attribute name="edited" value="S3lsZXI7S1lMRVI7MjAyNi0wOS0wNjswMTowOTowMSBQTTszOzIzMDA="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="scoreit" type="Integer" array="False" size=""/>
            <input variable="scoreit"/>
            <if expression="scoreit &gt; 100">
                <then>
                    <output expression="&quot;Invalid Input&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="scoreit &gt;= 90">
                        <then>
                            <output expression="&quot;Outstanding&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="scoreit &gt;= 80">
                                <then>
                                    <output expression="&quot;Very Satisfactory&quot;" newline="True"/>
                                </then>
                                <else>
                                    <if expression="scoreit &gt;= 75">
                                        <then>
                                            <output expression="&quot;Satisfactory&quot;" newline="True"/>
                                        </then>
                                        <else>
                                            <if expression="scoreit &lt; 0">
                                                <then>
                                                    <output expression="&quot;Invalid Input&quot;" newline="True"/>
                                                </then>
                                                <else>
                                                    <output expression="&quot;Needs Improvement&quot;" newline="True"/>
                                                </else>
                                            </if>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
